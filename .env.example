# Copy to .env (which git ignores) and fill in. Never paste these into chat or commits.
# Panel address, including the port. Use https:// if AMP is behind HTTPS.
AMP_URL=http://192.168.1.10:8443
# A dedicated bot user with a limited role. No 2FA or passkey on this account.
AMP_USERNAME=portcullis
# Leave empty to be asked for it when the recorder starts.
AMP_PASSWORD=
