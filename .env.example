# Copy to .env (which git ignores) and fill in. Never paste these into chat or commits.
# Panel address, including the port. Use https:// if AMP is behind HTTPS.
AMP_URL=http://192.168.1.10:8443
# A dedicated bot user with a limited role. No 2FA or passkey on this account.
AMP_USERNAME=portcullis
# Secrets: leave AMP_PASSWORD and DISCORD_TOKEN out of this file. Store them in the OS keyring with
#   python -m portcullis secrets set AMP_PASSWORD
#   python -m portcullis secrets set DISCORD_TOKEN
# (docs/SETUP.md section 6.1). AMP_PASSWORD_FILE / DISCORD_TOKEN_FILE also work, for Docker and systemd.
# Your Discord server's id (right-click the server icon, Copy Server ID). Required by the bot:
# slash commands are registered there only, and work nowhere else.
DISCORD_GUILD_ID=
# Discord user ids that may do everything, comma separated (usually just you).
PORTCULLIS_OWNER_IDS=
# Discord role ids allowed to start, stop and restart servers, comma separated.
PORTCULLIS_OPERATOR_ROLE_IDS=
# Optional: database path and log level (DEBUG, INFO, WARNING, ERROR).
# PORTCULLIS_DB=data/portcullis.db
# PORTCULLIS_LOG_LEVEL=INFO

# Optional: logs (docs/SETUP.md section 8.3). "off" for console only; json for one JSON object per line.
# PORTCULLIS_LOG_FILE=data/logs/portcullis.log
# PORTCULLIS_LOG_FORMAT=text
# PORTCULLIS_LOG_CONSOLE=text
# PORTCULLIS_LOG_MAX_MB=5
# PORTCULLIS_LOG_KEEP=5
# PORTCULLIS_BANNER=on
# Restart recovery: last run and last known server status. "off" turns it off.
# PORTCULLIS_STATE_FILE=data/state.json
# When the panel doesn't answer: extra tries for reads, and failures before calls pause.
# PORTCULLIS_PANEL_RETRIES=2
# PORTCULLIS_PANEL_TRIP_AFTER=3
# Health and metrics endpoint, off by default. Another host than 127.0.0.1 needs a token (16+ characters).
# PORTCULLIS_METRICS=off
# PORTCULLIS_METRICS_HOST=127.0.0.1
# PORTCULLIS_METRICS_PORT=9464
# PORTCULLIS_METRICS_TOKEN=
# Daily check for a newer release, off by default. "notify" posts in the alert channel; it never installs.
# PORTCULLIS_UPDATE_CHECK=off
# Start-up package check: set to off to never install missing packages (it still reports them).
# PORTCULLIS_AUTO_INSTALL=on
